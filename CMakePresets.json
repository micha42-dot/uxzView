{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 / project-local Qt SDK",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "${sourceDir}/.deps/sdk/ucrt64",
        "CMAKE_CXX_COMPILER": "${sourceDir}/.deps/sdk/ucrt64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/.deps/sdk/ucrt64/bin/ninja.exe",
        "BUILD_TESTING": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "native",
      "displayName": "Native Linux/macOS/Windows SDK",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "linux",
      "inherits": "native",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "macos-arm64",
      "inherits": "native",
      "binaryDir": "${sourceDir}/build/macos-arm64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0"
      }
    },
    {
      "name": "macos-x86_64",
      "inherits": "native",
      "binaryDir": "${sourceDir}/build/macos-x86_64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "jobs": 4
    },
    {
      "name": "native",
      "configurePreset": "native",
      "jobs": 4
    },
    {
      "name": "linux",
      "configurePreset": "linux",
      "jobs": 4
    },
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64",
      "jobs": 4
    },
    {
      "name": "macos-x86_64",
      "configurePreset": "macos-x86_64",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "native",
      "configurePreset": "native",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux",
      "configurePreset": "linux",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-x86_64",
      "configurePreset": "macos-x86_64",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
