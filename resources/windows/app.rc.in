// The executable icon is independent of Qt's runtime window icon.
1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/uxzView.ico"

// Product identity for Explorer and installers; not a code signature.
// Keep this block free of preprocessor includes: the MinGW build pipes this
// file through windres without include paths (see CMakeLists.txt).
1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3f
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 0x1
FILESUBTYPE 0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "IxView"
            VALUE "FileDescription", "uxzView Image Viewer"
            VALUE "FileVersion", "@PROJECT_VERSION@.0"
            VALUE "InternalName", "uxzView"
            VALUE "LegalCopyright", "GPL-3.0-or-later"
            VALUE "OriginalFilename", "uxzView.exe"
            VALUE "ProductName", "uxzView"
            VALUE "ProductVersion", "@PROJECT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
