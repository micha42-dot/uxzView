{
  "version": 1,
  "files": [
    "CMakeLists.txt", "CMakePresets.json", ".clang-format", ".gitignore",
    ".gitattributes", ".editorconfig", "LICENSE", "README.md", "PROJECT_STATUS.md",
    "CHANGELOG.md", "CONTRIBUTING.md", "SECURITY.md", "ügz.jpg", "example.jpg"
  ],
  "folders": ["src", "resources", "reference", "scripts", "docs", "tests", "cmake", ".github"],
  "exclude": [
    "docs/REQUIREMENTS.de.txt", "docs/WORK_IN_PROGRESS.md", "tests/output/*",
    "*/__pycache__", "*/__pycache__/*", "*/.git", "*/.git/*", "*/run-*", "*.pyc", "*.pyo", "*.part",
    "*/ixview-data", "*/ixview-data/*", "*/portable.mode", "*/portable.mode/*",
    "*/.ixview-portable.lock", "*/.ixview-portable.lock/*", "*/.ixview-profile-*"
  ],
  "reject_extensions": [".exe", ".dll", ".zip", ".pyc", ".pyo", ".part"],
  "reject_local_path": true
}
