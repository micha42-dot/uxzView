# Required, pinned native encoder. No libjpeg replacement, tools or runtime download.
include(FetchContent)
function(ix_add_jpegli)
    file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../scripts/native-sources-lock.json" ix_lock)
    foreach(name jpegli highway jpeg_headers)
        string(JSON url GET "${ix_lock}" sources ${name} url)
        string(JSON hash GET "${ix_lock}" sources ${name} sha256)
        string(JSON archive GET "${ix_lock}" sources ${name} file)
        set(cached "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../.deps/cache/${archive}")
        if(EXISTS "${cached}")
            set(url "${cached}")
        endif()
        # Download only; configure the minimal library targets below.
        FetchContent_Declare(ix_${name} URL "${url}" URL_HASH "SHA256=${hash}"
            SOURCE_SUBDIR uxzview-download-only DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
    endforeach()
    FetchContent_MakeAvailable(ix_jpegli ix_highway ix_jpeg_headers)
    set(HWY_ENABLE_TESTS OFF CACHE BOOL "" FORCE)
    set(HWY_ENABLE_EXAMPLES OFF CACHE BOOL "" FORCE)
    set(HWY_ENABLE_CONTRIB OFF CACHE BOOL "" FORCE)
    set(HWY_ENABLE_INSTALL OFF CACHE BOOL "" FORCE)
    set(HWY_FORCE_STATIC_LIBS ON CACHE BOOL "" FORCE)
    add_subdirectory("${ix_highway_SOURCE_DIR}" "${ix_highway_BINARY_DIR}" EXCLUDE_FROM_ALL)
    include("${ix_jpegli_SOURCE_DIR}/lib/jpegli_lists.cmake")
    list(TRANSFORM JPEGLI_INTERNAL_JPEGLI_SOURCES PREPEND "${ix_jpegli_SOURCE_DIR}/lib/")
    set(headers "${ix_jpegli_BINARY_DIR}/include/jpegli")
    file(MAKE_DIRECTORY "${headers}")
    set(BITS_IN_JSAMPLE 8)
    set(MEM_SRCDST_SUPPORTED 1)
    set(JPEG_LIB_VERSION 62)
    configure_file("${ix_jpeg_headers_SOURCE_DIR}/jconfig.h.in" "${headers}/jconfig.h")
    foreach(header jpeglib.h jmorecfg.h)
        configure_file("${ix_jpeg_headers_SOURCE_DIR}/${header}" "${headers}/${header}" COPYONLY)
    endforeach()
    add_library(ixjpegli STATIC ${JPEGLI_INTERNAL_JPEGLI_SOURCES})
    add_library(IxView::Jpegli ALIAS ixjpegli)
    set_target_properties(ixjpegli hwy PROPERTIES AUTOMOC OFF AUTOUIC OFF AUTORCC OFF
        POSITION_INDEPENDENT_CODE ON CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN ON)
    target_include_directories(ixjpegli PUBLIC "${ix_jpegli_SOURCE_DIR}" PRIVATE "${headers}")
    # Only the encoder TU uses jpegli's libjpeg62 struct layout. Do not shadow
    # the SDK jpeglib.h used by existing libjpeg-turbo coefficient transforms.
    set_source_files_properties(src/core/jpegli_encoder.cpp PROPERTIES INCLUDE_DIRECTORIES "${headers}")
    find_package(Threads REQUIRED)
    target_link_libraries(ixjpegli PRIVATE hwy Threads::Threads)
    # These are the same library sources as upstream jpegli-static, with unique
    # jpegli_* entry points; the ABI-compatible jpeg_* wrapper is never built.
    set(notices "${CMAKE_BINARY_DIR}/third-party-notices")
    foreach(name jpegli highway jpeg_headers)
        string(JSON count LENGTH "${ix_lock}" sources ${name} license_files)
        math(EXPR last "${count}-1")
        foreach(index RANGE ${last})
            string(JSON file GET "${ix_lock}" sources ${name} license_files ${index})
            configure_file("${ix_${name}_SOURCE_DIR}/${file}" "${notices}/${name}/${file}" COPYONLY)
        endforeach()
    endforeach()
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../scripts/native-sources-lock.json"
        "${notices}/native-sources-lock.json" COPYONLY)
    if(APPLE)
        install(DIRECTORY "${notices}/" DESTINATION "uxzView.app/Contents/Resources/licenses/native")
    else()
        install(DIRECTORY "${notices}/" DESTINATION "${CMAKE_INSTALL_DATADIR}/IxView/licenses/native")
    endif()
endfunction()
ix_add_jpegli()
