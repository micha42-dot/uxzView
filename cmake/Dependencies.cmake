# Normalize distro, Homebrew and upstream CMake package layouts.
find_package(libjpeg-turbo CONFIG QUIET)
if(TARGET libjpeg-turbo::turbojpeg)
    add_library(IxView::TurboJPEG ALIAS libjpeg-turbo::turbojpeg)
else()
    find_package(PkgConfig QUIET)
    if(PkgConfig_FOUND)
        pkg_check_modules(TURBOJPEG QUIET IMPORTED_TARGET libturbojpeg)
    endif()
    if(TARGET PkgConfig::TURBOJPEG)
        add_library(IxView::TurboJPEG ALIAS PkgConfig::TURBOJPEG)
    else()
        find_path(TURBOJPEG_INCLUDE_DIR turbojpeg.h REQUIRED)
        find_library(TURBOJPEG_LIBRARY NAMES turbojpeg REQUIRED)
        add_library(IxView::TurboJPEG UNKNOWN IMPORTED)
        set_target_properties(IxView::TurboJPEG PROPERTIES
            IMPORTED_LOCATION "${TURBOJPEG_LIBRARY}"
            INTERFACE_INCLUDE_DIRECTORIES "${TURBOJPEG_INCLUDE_DIR}")
    endif()
endif()

option(IX_ENABLE_METADATA "Enable EXIF/IPTC/XMP through Exiv2" ON)
if(IX_ENABLE_METADATA)
    find_package(exiv2 QUIET CONFIG)
    if(TARGET Exiv2::exiv2lib)
        add_library(IxView::Exiv2 ALIAS Exiv2::exiv2lib)
    elseif(TARGET exiv2lib)
        add_library(IxView::Exiv2 ALIAS exiv2lib)
    else()
        find_package(PkgConfig QUIET)
        if(PkgConfig_FOUND)
            pkg_check_modules(EXIV2 QUIET IMPORTED_TARGET exiv2>=0.27)
            if(TARGET PkgConfig::EXIV2)
                add_library(IxView::Exiv2 ALIAS PkgConfig::EXIV2)
            endif()
        endif()
    endif()
    if(NOT TARGET IxView::Exiv2)
        message(WARNING "Exiv2 not found: metadata preservation is unavailable in this build")
    endif()
endif()
